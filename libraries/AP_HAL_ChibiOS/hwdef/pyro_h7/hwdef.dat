
# hw definition file for processing by chibios_pins.py
# for STM32H743VIT6-Board
# (Reference : Matek H743-WING)

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID for firmware load
APJ_BOARD_ID 1013

# crystal frequency, setup to use external oscillator
OSCILLATOR_HZ 24000000

FLASH_SIZE_KB 2048
env OPTIMIZE -O2

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# use last 2 pages for flash storage
# H743 has 16 pages of 128k each
define STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 16384


# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

PC2 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT OPENDRAIN

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1
PA4 SDCARD_CS CS
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
#PD6 SDCARD_CS CS


# SPI3 - external
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PC12 SPI3_MOSI SPI3
PA15 FLASH_CS CS
PB12 BARO_CS CS

# SPI4 for IMU (icm42688)
PE11 IMU_CS CS
PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4

# LED
PB7 LED0 OUTPUT LOW GPIO(1)
define HAL_GPIO_A_LED_PIN 1
define HAL_GPIO_B_LED_PIN 2

#PB6 TIM4_CH1 TIM4 RCININT PULLDOWN LOW
PE9 TIM1_CH1 TIM1 RCININT PULLDOWN LOW


PA0  TIM5_CH1  TIM5 PWM(1) GPIO(50)
PA1  TIM5_CH2  TIM5 PWM(2) GPIO(51)
PA2  TIM5_CH3  TIM5 PWM(3) GPIO(52)
PA3  TIM5_CH4  TIM5 PWM(4) GPIO(53)
PC8  TIM3_CH3  TIM3 PWM(5) GPIO(54)
PD9  PYRO1     OUTPUT LOW  GPIO(55)
PD10 PYRO2     OUTPUT LOW  GPIO(56)
PD11 PYRO3     OUTPUT LOW  GPIO(57)
PD8  PYRO4     OUTPUT LOW  GPIO(58)


# order of UARTs (and USB)
SERIAL_ORDER OTG1  UART8 UART5 USART1

PB5 UART5_RX UART5
PB6 UART5_TX UART5

PE0 UART8_RX UART8
PE1 UART8_TX UART8

PB15 USART1_RX USART1
PB14 USART1_TX USART1

I2C_ORDER I2C4

PD12 I2C4_SCL I2C4 PULLUP
PD13 I2C4_SDA I2C4 PULLUP

DMA_PRIORITY S*


#CAD1 logic low, CAD0 logic low (b00001100) [internal mag]
COMPASS AK8963 I2C:0:0x0c ROTATION_NONE

#CAD1 logic high, CAD0 logic low (b00001110) [external mag]
#COMPASS AK8963 I2C:0:0x0e ROTATION_NONE

# spi devices
SPIDEV icm42688  SPI4 DEVID1 IMU_CS      MODE3  2*MHZ 16*MHZ   # Clock is 100Mhz so highest clock <= 24Mhz is 100Mhz/8
SPIDEV sdcard   SPI1 DEVID3 SDCARD_CS MODE0 400*KHZ 25*MHZ
SPIDEV dps310   SPI3 DEVID2 BARO_CS MODE3 5*MHZ 5*MHZ
SPIDEV spiflash   SPI3 DEVID4 FLASH_CS MODE3 32*MHZ 32*MHZ
#SPIDEV sdcard   SPI3 DEVID4 SDCARD_CS MODE0 400*KHZ 25*MHZ

DMA_NOSHARE SPI1* SPI4*

BARO DPS280  SPI:dps310
IMU Invensensev3 SPI:icm42688 ROTATION_YAW_180

# no built-in compass, but probe the i2c bus for all possible
# external compass types
define ALLOW_ARM_NO_COMPASS
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2
define HAL_BARO_ALLOW_INIT_NO_BARO

define HAL_DEFAULT_INS_FAST_SAMPLE 1

#define HAL_OS_FATFS_IO 1
#define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
#define HAL_BOARD_TERRAIN_DIRECTORY "/APM/TERRAIN"

undef HAL_MOUNT_ENABLED
undef AP_MOUNT_BACKEND_DEFUALT_ENABLED
undef HAL_MOUNT_CADDX_ENABLED
undef AP_CAMERA_MOUNT_ENABLED

define AP_CAMERA_MOUNT_ENABLED 1
define HAL_MOUNT_ENABLED 1
define AP_MOUNT_BACKEND_DEFUALT_ENABLED 0
define HAL_MOUNT_CADDX_ENABLED 1